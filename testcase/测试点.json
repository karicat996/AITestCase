
  "功能测试": {
    "等价类划分": [
      "杯子容量测试：测试杯子能否容纳标称容量的液体（如500ml）",
      "材料安全性测试：测试杯子材料是否符合食品安全标准（如无BPA）"
    ],
    "边界值分析": [
      "最大容量测试：测试杯子在达到最大容量时是否溢出",
      "最小使用测试：测试杯子在仅装入少量液体（如10ml）时是否正常使用"
    ],
    "错误推测法": [
      "异常使用测试：测试杯子在装入非液体物质（如固体）时的反应",
      "极端温度测试：测试杯子在装入过热（如100℃）或过冷（如0℃）液体时的表现"
    ],
    "场景法": [
      "日常使用场景：模拟日常喝水、倒水、清洗等操作",
      "户外使用场景：测试杯子的便携性和防漏性能"
    ],
    "判定表驱动法": [
      "盖子密封性测试：根据盖子是否拧紧、杯子是否倒置等条件测试是否漏水",
      "保温性能测试：根据杯子类型（保温/非保温）和环境温度测试保温效果"
    ],
    "正交试验法": [
      "多因素测试：测试杯子在不同温度、容量、使用频率下的综合性能"
    ],
    "功能图法": [
      "使用流程测试：测试从打开杯子、倒入液体、饮用、清洗到关闭的完整流程"
    ],
    "因果图法": [
      "漏水原因分析：分析可能导致漏水的原因（如盖子未拧紧、密封圈老化等）并测试"
    ]
  },
  "用户使用场景": {
    "家庭使用": [
      "日常饮水：测试杯子在家庭环境中多次使用的耐用性",
      "儿童使用：测试杯子的防摔性能和安全性"
    ],
    "办公使用": [
      "桌面放置：测试杯子在办公桌上放置时的稳定性和防滑性",
      "频繁使用：测试杯子在一天内多次使用后的清洁便利性"
    ],
    "户外活动": [
      "便携性：测试杯子是否便于携带（如是否有便携绳、是否轻便）",
      "防漏性：测试杯子在背包中移动时是否漏水"
    ],
    "旅行使用": [
      "密封性：测试杯子在旅行颠簸中是否保持密封",
      "多功能性：测试杯子是否适用于不同场景（如车内、酒店）"
    ],
    "运动使用": [
      "单手操作：测试杯子在运动时是否可以单手打开和关闭",
      "防溅设计：测试杯子在运动时饮水是否容易溅出"
    ]
  }
}
