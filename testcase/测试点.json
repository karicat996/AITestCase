"{\n  \"LCD光固化3D打印机\": [\n    {\n      \"Z轴功能模块\": [\n        {\n          \"Z轴升降精度测试\": [\n            {\n              \"正向测试（校准Z轴运动）\": \"通过打印机自带的Z轴校准功能，设置归零位、Z轴行程终点，测试多次归零和运动后，Z轴实际位置与设定位置偏差在±0.02mm以内，打印模型层纹均匀无台阶\"\n            },\n            {\n              \"反向测试（Z轴卡顿或超行程）\": \"手动给Z轴丝杆施加阻力（如涂抹过量油脂），启动Z轴运动，应触发防卡死保护、自动停止并报错，停止后无法继续移动；设置Z轴行程超过机械限位时，设备应限位保护并弹出超行程警告\"\n            }\n          ]\n        },\n        {\n          \"Z轴电机负载测试\": [\n            {\n              \"正向测试（正常承载打印平台）\": \"将满载树脂（如1kg）的打印托盘固定在Z轴平台上，执行升降速度10mm/s，连续反复升降100次，Z轴无丢步、无异响、打印平台水平度变化≤0.05mm\"\n            },\n            {\n              \"反向测试（过载保护）\": \"在打印平台上额外增加2kg配重，启动Z轴升降，5秒内应触发过载保护，电机停止转动并发出蜂鸣警报，用户界面上显示‘负载超重，请减重’提示\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"加热功能模块\": [\n        {\n          \"恒温加热测试\": [\n            {\n              \"正向测试（设置目标温度并保持）\": \"通过菜单设置树脂槽加热温度为30℃，启动加热，环境温度25℃下，监测树脂温度：应在10分钟内达到30±1℃，并在连续保温2小时内温度波动不超过±1℃\"\n            },\n            {\n              \"反向测试（超温保护）\": \"手动将加热传感器短路模拟温度超过设定值5℃（如35℃），设备应在3秒内自动关闭加热器，屏幕显示‘超温，已停止加热’；继续升温至45℃时，系统应强制断电且需手动重启才能恢复\"\n            }\n          ]\n        },\n        {\n          \"加热异常恢复测试\": [\n            {\n              \"正向测试（断电后温度记忆）\": \"加热到30℃稳定后，突然拔掉电源，等待10秒后重新上电，设备应自动读取上次保存的温度（30℃），并继续控制加热器维持该温度\"\n            },\n            {\n              \"反向测试（加热传感器失效）\": \"断开加热热敏电阻连接，启动打印，设备应在5秒内检测到传感器失效，弹出‘温度传感器故障，加热功能禁用’提示，同时禁止开始任何打印任务\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"曝光时间功能模块\": [\n        {\n          \"曝光时间设置精准性\": [\n            {\n              \"正向测试（自定义曝光时间）\": \"设置基础曝光时间为8.0秒，底层曝光80.0秒，使用计时精度±5ms的测试仪测量实际曝光脉冲，连续测试20层，每层误差≤0.1秒，总曝光时长误差≤1%\"\n            },\n            {\n              \"反向测试（超范围时间设置）\": \"在曝光时间输入栏输入-5.0秒或999.9秒时，系统应拒绝接受，输入框高亮红色并提示‘曝光时间超出范围（0.1~30.0秒）’，且无法保存或启动打印\"\n            }\n          ]\n        },\n        {\n          \"曝光时序与Z轴同步\": [\n            {\n              \"正向测试（曝光-升降-光固化同步）\": \"设定层厚0.05mm、曝光10秒，打印一个20mm立方体，实际测量每层停留曝光时长与设定的10秒偏差≤0.3秒，且Z轴升降完成并稳定后LCD才点亮曝光，无提前或延迟曝光导致的层间粘附不均\"\n            },\n            {\n              \"反向测试（曝光时机错乱）\": \"通过固件修改强制使Z轴升降完成前5秒提前曝光，设备应通过光栅检测或时序校验自动停止打印，显示‘曝光与Z轴不同步，请检查固件’，且无法继续打印\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"延时打印功能模块\": [\n        {\n          \"定时启动打印测试\": [\n            {\n              \"正向测试（设置延时并成功启动）\": \"当前时间10:00，设置延时打印2小时后（12:00），关闭打印机并断开Wi-Fi，2小时后设备自动上电并开始预热加热器，预热至设定温度（如30℃）后自动开始打印第一层，整个过程无人值守且成功打印\"\n            },\n            {\n              \"反向测试（时间设置错误或冲突）\": \"尝试将延时打印时间设置为当前时间之前（如当前10:00，设置延时-1小时），系统应弹窗提示‘延时时间不得早于当前时间’；当设备正在打印时尝试设置延时打印，应提示‘请先完成当前打印再设置延时任务’\"\n            }\n          ]\n        },\n        {\n          \"延时取消与修改测试\": [\n            {\n              \"正向测试（成功取消延时任务）\": \"设定延时打印后，在倒计时剩余1小时时通过菜单取消任务，设备回到待机状态，取消后无任何残留定时器，拔电后再次上电不会自动恢复延时任务\"\n            },\n            {\n              \"反向测试（强制断电后延时丢失）\": \"设定延时打印并正在倒计时（剩余30分钟），突然断电，在5秒内重新上电，延时任务应自动失效，界面显示‘上次延时任务中断，请重新设置’，并跳转到待机主页\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"中断打印续打功能模块\": [\n        {\n          \"断电续打测试\": [\n            {\n              \"正向测试（意外断电后恢复打印）\": \"打印进行到50层时（总100层），突然断电，等待2分钟后重新上电，打印机自动检测到未完成打印，界面弹出‘检测到中断任务，是否续打？’，选择‘是’，设备加热至设定温度并自动回到第50层开始状态，继续打印第51层至完成，模型无层纹错位或缺失\"\n            },\n            {\n              \"反向测试（存储芯片数据损坏）\": \"在打印至50层时强制拔出SD卡，模拟存储损坏，重新上电时设备无法读取续打数据，应提示‘续打数据丢失，建议重新切片并打印’，且不启动任何自动恢复流程\"\n            }\n          ]\n        },\n        {\n          \"手动暂停/续打测试\": [\n            {\n              \"正向测试（暂停后更换树脂）\": \"打印到30层时按下暂停键，设备自动关闭曝光并提Z轴10mm，等待20秒后更换同一品牌树脂，点击‘继续’，设备下降至打印平面、重新曝光最后3层以确保层间粘合，继续完成后续打印且模型表面无明显断层\"\n            },\n            {\n              \"反向测试（暂停超时自动取消）\": \"暂停打印后设定最长暂停时间为10分钟，当暂停时间达到10分钟零30秒时设备自动取消打印任务，并弹出‘暂停超时，已自动取消’，将打印平台复位至最高点，并放回待机状态\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"支持多种树脂打印模块\": [\n        {\n          \"树脂类型切换测试\": [\n            {\n              \"正向测试（标准树脂、柔性树脂、透明树脂顺利打印）\": \"分别使用标准刚性树脂、柔性树脂（邵氏硬度70A）、透明树脂，采用对应推荐参数（层厚0.05mm，曝光时间8/10/12秒），各打印一个10mm立方体，均能完整成型、层间结合牢固、无开裂或翘边\"\n            },\n            {\n              \"反向测试（不兼容树脂提示）\": \"在树脂库中选择‘陶瓷树脂’，设备应弹出‘当前未适配该树脂参数，请使用官方认证树脂或手动输入参数’；若强行选择并启动打印，LCD光源亮度不足（陶瓷树脂需更高能量），打印物无法固化并报错‘模型未固化，请检查树脂兼容性’\"\n            }\n          ]\n        },\n        {\n          \"树脂参数记忆与自动匹配\": [\n            {\n              \"正向测试（记忆上次使用的树脂类型及参数）\": \"上次打印使用‘柔性树脂(曝光10s,层厚0.05mm)’，关机重启后，在‘选择树脂’界面默认选中该树脂，且曝光时间、层厚等参数自动填充为上次值，无需重新设置即可开始打印\"\n            },\n            {\n              \"反向测试（参数冲突时警告）\": \"手动将一个树脂参数（如标准树脂曝光时间8秒）修改为3秒，保存时设备应检测到该时间低于该树脂推荐最小值（默认5秒），弹出‘曝光时间过短可能导致固化失败，是否继续？’，若选择‘是’，则允许保存但自动在打印列表中标记黄色警告图标\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"支持连接App模块\": [\n        {\n          \"App连接与通信测试\": [\n            {\n              \"正向测试（蓝牙/Wi-Fi连接App并同步状态）\": \"打开手机App，搜索到打印机蓝牙信号并配对，成功连接后App界面实时显示当前打印进度（如50%）、Z轴高度（15.2mm）、树脂温度（30.2℃）、剩余时间（1h20min），且与打印机屏幕数据一致（刷新延迟≤2秒）\"\n            },\n            {\n              \"反向测试（连接干扰与断连恢复）\": \"打印机与App已连接，在App端手动关闭蓝牙，打印机应在5秒内检测到连接断开，屏幕上不显示任何App控制图标并恢复本地控制模式；当重新打开App蓝牙，可在一分钟内自动重连并恢复同步状态，未丢失打印任务\"\n            }\n          ]\n        },\n        {\n          \"App远程控制功能测试\": [\n            {\n              \"正向测试（通过App设置参数并启动打印）\": \"通过App远程设置曝光时间为10秒、加热温度28℃，并选择已切片文件‘demo.lgs’启动打印，打印机在接收指令后3秒内开始预热，预热完成后自动开始打印，App端实时更新每层进度\"\n            },\n            {\n              \"反向测试（App发送无效指令）\": \"通过App发送一个不存在于打印机固件的命令（如设定曝光时间为-2秒），打印机收到后应返回错误码并拒绝执行，App端弹出‘无效参数，请重新输入’提示，且打印机继续当前状态（待机或打印中）不受影响\"\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}"